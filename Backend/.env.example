# ============================================
# ELECTION ATLAS - ENVIRONMENT CONFIGURATION
# ============================================

# Node Environment
NODE_ENV=development

# ============================================
# SMS GATEWAY CONFIGURATION (Real Setup)
# ============================================
# Note: SMS configuration is centralized in config/smsConfig.js
# These environment variables are for OTP-specific settings only

# CSV Export OTP Settings
CSV_OTP_MOBILE_NUMBER=8839475693
CSV_EXPORT_OTP_TTL_MINUTES=5
CSV_EXPORT_OTP_LENGTH=6

# Booth Volunteer OTP Settings
BOOTH_VOLUNTEER_OTP_TTL_MINUTES=5
BOOTH_VOLUNTEER_OTP_LENGTH=6

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Add your MongoDB connection string here
# MONGODB_URI=mongodb://localhost:27017/election-atlas

# ============================================
# JWT CONFIGURATION
# ============================================
# Add your JWT secret here
# JWT_SECRET=your_jwt_secret_key_here
# JWT_EXPIRE=30d

# ============================================
# SERVER CONFIGURATION
# ============================================
# PORT=5000

# ============================================
# NOTES
# ============================================
# 1. SMS Gateway credentials are in config/smsConfig.js
# 2. Never commit this file with real credentials
# 3. Copy this file to .env and fill in your values
# 4. In production, set NODE_ENV=production
